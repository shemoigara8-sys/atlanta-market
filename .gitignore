:root {
  font-family: 'Inter', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #0f172a;
  background: #f8fafc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  --primary: #f97316;
  --primary-dark: #ea580c;
  --secondary: #1d4ed8;
  --bg: #f8fafc;
  --card: #ffffff;
  --muted: #64748b;
  --line: #e2e8f0;
  --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: linear-gradient(180deg, #fff7ed 0%, #f8fafc 25%, #f8fafc 100%);
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

#root {
  min-height: 100vh;
}

.page-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 20px 80px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 22px;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(148, 163, 184, 0.18);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  box-shadow: var(--shadow);
  position: sticky;
  top: 18px;
  z-index: 20;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #fb923c);
  border-radius: 14px;
  color: white;
  font-weight: 800;
}

.brand-name {
  margin: 0;
  font-weight: 800;
  font-size: 1.05rem;
}

.brand-tag {
  color: var(--muted);
  font-size: 0.75rem;
}

.nav {
  display: flex;
  gap: 24px;
}

.nav a {
  color: #334155;
  text-decoration: none;
  font-weight: 500;
}

.nav-actions {
  display: flex;
  gap: 12px;
  align-items: center;
}

.btn {
  border: none;
  border-radius: 12px;
  padding: 0.8rem 1.2rem;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  box-shadow: 0 14px 30px rgba(249, 115, 22, 0.25);
}

.btn-ghost {
  background: #fff;
  color: #0f172a;
  border: 1px solid var(--line);
}

.hero {
  margin-top: 32px;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 28px;
  align-items: center;
}

.hero-copy,
.hero-panel {
  background: rgba(255, 255, 255, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.hero-copy {
  padding: 54px 42px;
}

.eyebrow {
  display: inline-block;
  color: var(--secondary);
  background: rgba(29, 78, 216, 0.08);
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.hero-copy h1 {
  margin: 20px 0 16px;
  font-size: clamp(2.5rem, 3vw, 4.2rem);
  line-height: 1.08;
  letter-spacing: -0.06em;
}

.hero-copy p {
  margin: 0;
  max-width: 540px;
  color: var(--muted);
  font-size: 1.05rem;
}

.searchbar {
  margin-top: 26px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 10px 12px 10px 16px;
}

.searchbar span {
  font-size: 1.2rem;
}

.searchbar input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 0.98rem;
  color: var(--muted);
  background: transparent;
}

.searchbar .btn {
  padding-inline: 1rem;
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}

.hero-badges span {
  background: #f1f5f9;
  border: 1px solid var(--line);
  padding: 0.6rem 0.8rem;
  border-radius: 999px;
  font-size: 0.85rem;
  color: #334155;
  font-weight: 600;
}

.hero-panel {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.panel-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 20px;
}

.card-main {
  background: linear-gradient(135deg, #fff7ed, #ffffff);
}

.mini-card {
  display: inline-flex;
  flex-direction: column;
  padding: 0.8rem 1rem;
  border-radius: 16px;
  margin-bottom: 22px;
}

.mini-card-green {
  background: #dcfce7;
  color: #166534;
}

.mini-card p,
.card-side p,
.showcase-label {
  margin: 0;
  font-size: 0.8rem;
  color: var(--muted);
}

.mini-card strong {
  font-size: 1.4rem;
}

.product-showcase {
  display: flex;
  gap: 18px;
  align-items: center;
  background: white;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px;
}

.showcase-icon {
  width: 82px;
  height: 82px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  font-size: 2.2rem;
}

.product-showcase h3 {
  margin: 8px 0;
  font-size: 1.3rem;
}

.showcase-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: #475569;
  font-weight: 700;
}

.card-side ul {
  list-style: none;
  margin: 14px 0 0;
  padding: 0;
  display: grid;
  gap: 12px;
}

.card-side li {
  background: #f8fafc;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 0.8rem 1rem;
  font-weight: 600;
  color: #334155;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-top: 34px;
}

.stat-box {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  box-shadow: var(--shadow);
  border-radius: 18px;
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-box strong {
  font-size: clamp(1.5rem, 2vw, 2.2rem);
  letter-spacing: -0.05em;
}

.stat-box span {
  color: var(--muted);
  font-weight: 600;
}

.categories,
.products,
.how-it-works {
  margin-top: 56px;
}

.section-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.section-head h2 {
  margin: 12px 0 0;
  font-size: clamp(1.8rem, 2vw, 2.5rem);
  letter-spacing: -0.05em;
}

.category-grid,
.product-grid,
.steps-grid {
  display: grid;
  gap: 18px;
}

.category-grid {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.category-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 22px;
  padding: 24px 18px;
  box-shadow: var(--shadow);
  transition: transform 0.2s ease;
}

.category-card:hover {
  transform: translateY(-4px);
}

.category-card h3 {
  margin: 18px 0 8px;
  font-size: 1.1rem;
}

.category-card p {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-size: 1.6rem;
  background: rgba(255, 255, 255, 0.75);
}

.orange .icon-wrap {
  background: #ffedd5;
}

.pink .icon-wrap {
  background: #fce7f3;
}

.blue .icon-wrap {
  background: #dbeafe;
}

.green .icon-wrap {
  background: #dcfce7;
}

.purple .icon-wrap {
  background: #ede9fe;
}

.rose .icon-wrap {
  background: #ffe4e6;
}

.product-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.product-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 22px;
  padding: 16px;
  box-shadow: var(--shadow);
}

.product-image {
  height: 180px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  font-size: 4rem;
  background: linear-gradient(135deg, #f8fafc, #e2e8f0);
}

.product-tag {
  margin-top: 14px;
  display: inline-block;
  background: #fff7ed;
  color: var(--primary-dark);
  border-radius: 999px;
  padding: 0.45rem 0.7rem;
  font-size: 0.74rem;
  font-weight: 700;
}

.product-info h3 {
  margin: 14px 0 8px;
  font-size: 1.2rem;
}

.rating-row,
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.rating-row {
  color: var(--muted);
  font-size: 0.9rem;
}

.price-row {
  margin-top: 18px;
}

.price-row strong {
  font-size: 1.2rem;
}

.price-row button {
  background: #0f172a;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 0.7rem 1rem;
  font-weight: 700;
}

.steps-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.step-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 22px;
  padding: 22px 18px;
  box-shadow: var(--shadow);
}

.step-number {
  display: inline-flex;
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: var(--secondary);
  align-items: center;
  justify-content: center;
  font-weight: 800;
  margin-bottom: 14px;
}

.step-card p {
  margin: 0;
  color: #334155;
  font-weight: 600;
}

.center {
  justify-content: center;
  text-align: center;
}

@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .category-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .steps-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .topbar {
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-actions {
    width: 100%;
    justify-content: center;
  }

  .stats-row,
  .category-grid,
  .product-grid,
  .steps-grid {
    grid-template-columns: 1fr;
  }

  .searchbar {
    flex-wrap: wrap;
  }

  .hero-copy,
  .hero-panel {
    padding: 22px 18px;
  }
}
